{
  "name": "node-socketio-chatroom",
  "version": "1.11.0",
  "description": "Production-hardened Socket.IO chatroom with encrypted persistence and safe lifecycle tooling",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "build": "node scripts/build-assets.js",
    "check": "node --check src/server.js && node --check src/lib/config.js && node --check src/lib/logger.js && node --check src/lib/security.js && node --check src/lib/storage.js && node --check src/lib/uploads.js && node --check public/assets/app.js && node --check scripts/build-assets.js && node --check scripts/smoke-test.js && node --check scripts/browser-smoke.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:unit": "node --test --test-concurrency=1 tests/storage.test.js tests/config.test.js tests/security.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/runtime.test.js tests/upgrade.test.js",
    "test:security": "node --test --test-concurrency=1 tests/security.test.js tests/upload.test.js",
    "smoke": "node scripts/smoke-test.js",
    "browser-smoke": "node scripts/browser-smoke.js"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "multer": "2.4.0",
    "socket.io": "^4.7.2",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.3",
    "vue": "3.5.42",
    "@tailwindcss/cli": "^4.3.3",
    "braces": "npm:@dieub/braces-depth-guard@3.0.3-pn.2"
  },
  "overrides": {
    "engine.io": "6.6.10",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "source-map-js": "1.2.2",
    "braces": "$braces"
  }
}
